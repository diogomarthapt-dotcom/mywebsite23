---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<a href="/" class="brand">{SITE_TITLE}</a>
		<div class="nav-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="social-links">
			<a href="https://instagram.com/diogomartha23" target="_blank" aria-label="Instagram">
				<span class="sr-only">Instagram</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
					<rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
					<circle cx="12" cy="12" r="4.5"/>
					<circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
				</svg>
			</a>
			<a href="https://twitter.com/diogomartha23" target="_blank" aria-label="Twitter / X">
				<span class="sr-only">Twitter</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22" fill="currentColor">
					<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
				</svg>
			</a>
			<a href="https://github.com/diogomartha23" target="_blank" aria-label="GitHub">
				<span class="sr-only">GitHub</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22" fill="currentColor">
					<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
				</svg>
			</a>
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		margin: 0;
		padding: 0 1.5em;
		background: rgba(255, 255, 255, 0.9);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid rgb(var(--gray-light));
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
		max-width: 960px;
		margin: 0 auto;
		height: 60px;
	}

	.brand {
		font-weight: 700;
		font-size: 1em;
		color: rgb(var(--black));
		text-decoration: none;
		letter-spacing: -0.02em;
		white-space: nowrap;
		flex-shrink: 0;
	}
	.brand:hover { color: var(--accent); }

	.nav-links {
		display: flex;
		gap: 0.25em;
	}

	.nav-links :global(a) {
		padding: 0.4em 0.75em;
		color: rgb(var(--gray));
		border-radius: 6px;
		text-decoration: none;
		font-size: 0.95em;
		transition: var(--transition);
	}
	.nav-links :global(a:hover),
	.nav-links :global(a.active) {
		color: rgb(var(--black));
		background: rgb(var(--gray-light));
	}
	.nav-links :global(a.active) {
		font-weight: 700;
	}

	.social-links {
		display: flex;
		align-items: center;
		gap: 0.25em;
	}
	.social-links a {
		display: flex;
		align-items: center;
		padding: 0.4em;
		color: rgb(var(--gray));
		border-radius: 6px;
		text-decoration: none;
		transition: var(--transition);
	}
	.social-links a:hover {
		color: rgb(var(--black));
		background: rgb(var(--gray-light));
	}

	@media (max-width: 720px) {
		.social-links { display: none; }
		header { padding: 0 1em; }
	}
</style>
