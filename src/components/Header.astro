---
import { SITE_TITLE } from '../consts';
---

<header class="app-header">
  <div class="container header-inner">
    <a href="/" class="logo">
      <span class="logo-icon">🌾</span>
      <span class="logo-text">{SITE_TITLE}</span>
    </a>
    <nav class="main-nav">
      <a href="/" class="nav-link">Início</a>
      <a href="/como-funciona" class="nav-link">Como Funciona</a>
    </nav>
    <a href="/carrinho" class="cart-link" id="cart-link" aria-label="Ver carrinho">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>
      </svg>
      <span class="cart-badge" id="cart-badge" aria-live="polite"></span>
    </a>
  </div>
</header>

<script>
  function updateCartBadge() {
    try {
      const raw = localStorage.getItem('colheita_cart');
      const cart = raw ? JSON.parse(raw) : { items: [] };
      const count: number = cart.items.reduce((s: number, i: { quantity: number }) => s + i.quantity, 0);
      const badge = document.getElementById('cart-badge');
      if (badge) {
        badge.textContent = count > 0 ? String(count) : '';
        badge.style.display = count > 0 ? 'flex' : 'none';
      }
    } catch (_) {}
  }

  updateCartBadge();
  window.addEventListener('storage', updateCartBadge);
  document.addEventListener('colheita:cartUpdated', updateCartBadge);
</script>

<style>
  .app-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: #fff;
    border-bottom: 1px solid var(--border);
    box-shadow: 0 1px 4px var(--shadow);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
    gap: 1rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    flex-shrink: 0;
  }
  .logo-icon { font-size: 1.5rem; line-height: 1; }
  .logo-text {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--green-800);
    letter-spacing: -0.02em;
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex: 1;
    justify-content: center;
  }
  .nav-link {
    padding: 0.4rem 0.85rem;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s, background 0.15s;
  }
  .nav-link:hover {
    color: var(--green-700);
    background: var(--green-50);
  }

  .cart-link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 10px;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s, background 0.15s;
    flex-shrink: 0;
  }
  .cart-link:hover { color: var(--green-700); background: var(--green-50); }

  .cart-badge {
    display: none;
    position: absolute;
    top: 4px;
    right: 4px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--orange);
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  @media (max-width: 500px) {
    .main-nav { display: none; }
  }
</style>
