---
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<div class="footer-brand">
			<span class="name">Diogo Martha</span>
			<span class="copy">&copy; {today.getFullYear()} — All rights reserved.</span>
		</div>
		<div class="social-links">
			<a href="https://instagram.com/diogomartha23" target="_blank" aria-label="Instagram">
				<svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
					<rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
					<circle cx="12" cy="12" r="4.5"/>
					<circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
				</svg>
				Instagram
			</a>
			<a href="https://twitter.com/diogomartha23" target="_blank" aria-label="Twitter">
				<svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18" fill="currentColor">
					<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
				</svg>
				Twitter
			</a>
			<a href="https://github.com/diogomartha23" target="_blank" aria-label="GitHub">
				<svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18" fill="currentColor">
					<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
				</svg>
				GitHub
			</a>
		</div>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid rgb(var(--gray-light));
		padding: 2.5em 1.5em;
		background: #fff;
	}

	.footer-inner {
		max-width: 960px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5em;
		flex-wrap: wrap;
	}

	.footer-brand {
		display: flex;
		flex-direction: column;
		gap: 0.2em;
	}

	.name {
		font-weight: 700;
		color: rgb(var(--black));
		font-size: 0.95em;
		letter-spacing: -0.01em;
	}

	.copy {
		font-size: 0.8em;
		color: rgb(var(--gray));
	}

	.social-links {
		display: flex;
		align-items: center;
		gap: 0.25em;
	}

	.social-links a {
		display: flex;
		align-items: center;
		gap: 0.4em;
		padding: 0.4em 0.75em;
		color: rgb(var(--gray));
		font-size: 0.85em;
		border-radius: 6px;
		text-decoration: none;
		transition: var(--transition);
	}

	.social-links a:hover {
		color: rgb(var(--black));
		background: rgb(var(--gray-light));
	}

	@media (max-width: 600px) {
		.footer-inner { flex-direction: column; align-items: flex-start; }
	}
</style>
