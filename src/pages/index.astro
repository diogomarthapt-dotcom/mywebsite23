---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<!-- Hero -->
		<section class="hero">
			<!--
				HIGGSFIELD VIDEO — drop your generated .mp4 here:
				<video class="hero-video" autoplay muted loop playsinline poster="/hero-poster.jpg">
					<source src="/hero.mp4" type="video/mp4" />
				</video>
			-->
			<div class="hero-bg" aria-hidden="true"></div>
			<div class="hero-content">
				<p class="hero-eyebrow">Hi, I'm</p>
				<h1 class="hero-name">Diogo Martha</h1>
				<p class="hero-tagline">Designer, developer, and creator.<br />Writing about technology, design,<br />and building on the internet.</p>
				<div class="hero-actions">
					<a href="/blog" class="btn btn-primary">Read the Blog</a>
					<a href="/about" class="btn btn-ghost">About Me</a>
				</div>
			</div>
			<div class="hero-scroll" aria-hidden="true">
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
					<path d="M12 5v14M5 12l7 7 7-7"/>
				</svg>
			</div>
		</section>

		<!-- Latest posts -->
		<section class="posts-section">
			<div class="posts-inner">
				<div class="section-header">
					<h2>Latest Posts</h2>
					<a href="/blog" class="see-all">All posts →</a>
				</div>
				<ul class="posts-list">
					{posts.map((post) => (
						<li class="post-card">
							<a href={`/blog/${post.id}/`} class="post-card-link">
								{post.data.heroImage && (
									<div class="post-card-image">
										<img src={post.data.heroImage} alt="" width="400" height="200" />
									</div>
								)}
								<div class="post-card-body">
									<p class="post-card-date">
										<FormattedDate date={post.data.pubDate} />
									</p>
									<h3 class="post-card-title">{post.data.title}</h3>
									<p class="post-card-desc">{post.data.description}</p>
								</div>
							</a>
						</li>
					))}
				</ul>
			</div>
		</section>

		<Footer />
	</body>
</html>

<style>
	/* ── Hero ── */
	.hero {
		position: relative;
		min-height: calc(100svh - 60px);
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
	}

	.hero-bg {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(ellipse 80% 60% at 50% 0%, rgba(35, 55, 255, 0.07) 0%, transparent 70%),
			linear-gradient(180deg, #f8f9ff 0%, #fff 100%);
		z-index: 0;
	}

	/* When a Higgsfield video is added, it goes here */
	.hero-video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: 0;
		opacity: 0.35;
	}

	.hero-content {
		position: relative;
		z-index: 1;
		text-align: center;
		padding: 2em 1.5em;
		max-width: 640px;
		animation: fadeUp 0.8s cubic-bezier(0.4, 0, 0.2, 1) both;
	}

	.hero-eyebrow {
		font-size: 0.9em;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent);
		font-weight: 700;
		margin: 0 0 0.5em;
	}

	.hero-name {
		font-size: clamp(3rem, 10vw, 5.5rem);
		font-weight: 700;
		letter-spacing: -0.04em;
		line-height: 1;
		color: rgb(var(--black));
		margin: 0 0 0.4em;
	}

	.hero-tagline {
		font-size: clamp(1rem, 2.5vw, 1.2rem);
		color: rgb(var(--gray));
		line-height: 1.6;
		margin: 0 0 2em;
	}

	.hero-actions {
		display: flex;
		gap: 0.75em;
		justify-content: center;
		flex-wrap: wrap;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		padding: 0.65em 1.5em;
		border-radius: 8px;
		font-size: 0.95em;
		font-weight: 700;
		text-decoration: none;
		transition: var(--transition);
		letter-spacing: -0.01em;
	}

	.btn-primary {
		background: var(--accent);
		color: #fff;
		box-shadow: 0 1px 3px rgba(35, 55, 255, 0.3), 0 4px 12px rgba(35, 55, 255, 0.2);
	}
	.btn-primary:hover {
		background: var(--accent-light);
		color: #fff;
		transform: translateY(-1px);
		box-shadow: 0 4px 16px rgba(35, 55, 255, 0.35);
	}

	.btn-ghost {
		background: transparent;
		color: rgb(var(--gray-dark));
		border: 1.5px solid rgb(var(--gray-light));
	}
	.btn-ghost:hover {
		border-color: rgb(var(--gray));
		color: rgb(var(--black));
		transform: translateY(-1px);
	}

	.hero-scroll {
		position: absolute;
		bottom: 2em;
		left: 50%;
		transform: translateX(-50%);
		color: rgb(var(--gray));
		animation: bounce 2s ease-in-out infinite;
		z-index: 1;
	}

	/* ── Posts section ── */
	.posts-section {
		background: var(--surface, #fafbff);
		border-top: 1px solid rgb(var(--gray-light));
		padding: 4em 1.5em;
	}

	.posts-inner {
		max-width: 960px;
		margin: 0 auto;
	}

	.section-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 2em;
	}

	.section-header h2 {
		font-size: 1.5rem;
		letter-spacing: -0.03em;
	}

	.see-all {
		font-size: 0.9em;
		font-weight: 700;
		color: var(--accent);
		text-decoration: none;
		transition: var(--transition);
	}
	.see-all:hover { color: var(--accent-light); }

	.posts-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1.5em;
	}

	.post-card {
		background: #fff;
		border: 1px solid rgb(var(--gray-light));
		border-radius: var(--radius);
		overflow: hidden;
		transition: var(--transition);
	}
	.post-card:hover {
		box-shadow: var(--box-shadow);
		transform: translateY(-3px);
		border-color: transparent;
	}

	.post-card-link {
		display: block;
		text-decoration: none;
		color: inherit;
		height: 100%;
	}

	.post-card-image img {
		width: 100%;
		height: 180px;
		object-fit: cover;
		border-radius: 0;
		display: block;
	}

	.post-card-body {
		padding: 1.25em;
	}

	.post-card-date {
		font-size: 0.8em;
		color: rgb(var(--gray));
		margin: 0 0 0.4em;
		letter-spacing: 0.02em;
	}

	.post-card-title {
		font-size: 1.1em;
		letter-spacing: -0.02em;
		color: rgb(var(--black));
		margin: 0 0 0.5em;
		line-height: 1.3;
		transition: var(--transition);
	}
	.post-card:hover .post-card-title { color: var(--accent); }

	.post-card-desc {
		font-size: 0.875em;
		color: rgb(var(--gray));
		margin: 0;
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/* ── Animations ── */
	@keyframes fadeUp {
		from { opacity: 0; transform: translateY(24px); }
		to   { opacity: 1; transform: translateY(0); }
	}

	@keyframes bounce {
		0%, 100% { transform: translateX(-50%) translateY(0); }
		50%       { transform: translateX(-50%) translateY(6px); }
	}

	@media (max-width: 720px) {
		.posts-section { padding: 2.5em 1em; }
		.posts-list { grid-template-columns: 1fr; }
	}
</style>
