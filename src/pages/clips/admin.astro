---
export const prerender = false;

import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';

interface Clip {
  id: string; url: string; title: string; description: string;
  tags: string[]; date: string; scheduledDate?: string;
  stage: 'to-watch' | 'watching' | 'watched';
  thumbnail?: string; channel?: string; duration?: string;
  rating?: number; moments?: Array<{ time: string; note: string }>;
  collection?: string; clipType?: string;
}

function getHostname(url: string) {
  try { return new URL(url).hostname.replace('www.', ''); } catch { return url; }
}

const stageLabel: Record<string, string> = {
  'to-watch': '📋 Para ver', 'watching': '▶️ A ver', 'watched': '✅ Visto',
};
const typeEmoji: Record<string, string> = {
  tutorial: '📘', inspiration: '💡', research: '🔬',
  entertainment: '🎬', news: '📰', other: '📎',
};

let clips: Clip[] = [];
let collections: string[] = [];
try {
  const { env } = Astro.locals.runtime;
  const json = await env.CLIPS_KV.get('clips');
  clips = json ? JSON.parse(json) : [];
  collections = [...new Set(clips.map(c => c.collection).filter(Boolean) as string[])].sort();
} catch { /* no KV */ }
---

<!doctype html>
<html lang="pt">
<head>
  <BaseHead title={`Admin | ${SITE_TITLE}`} description="Gerir clips" />
</head>
<body>
  <Header />
  <main>
    <h1>Admin — Clipping</h1>

    <!-- Lock screen -->
    <div id="lock-screen">
      <p>Palavra-passe de administrador:</p>
      <form id="password-form">
        <div class="pw-row">
          <input type="password" id="password-input" placeholder="Palavra-passe" autocomplete="current-password" />
          <button type="submit">Entrar</button>
        </div>
        <p id="auth-error" class="msg-error" style="display:none">Palavra-passe incorreta.</p>
      </form>
    </div>

    <!-- Admin panel -->
    <div id="admin-panel" style="display:none">

      <!-- ── Add Clip Form ─────────────────────────────────── -->
      <section class="add-section">
        <h2>Adicionar Clip</h2>
        <form id="add-form" autocomplete="off">

          <!-- URL + YouTube fetch -->
          <div class="url-row">
            <div class="field" style="flex:1">
              <label for="url">URL *</label>
              <input type="url" id="url" name="url" placeholder="https://youtube.com/... ou qualquer URL" required />
            </div>
            <span id="fetch-status" class="fetch-status"></span>
          </div>

          <!-- YouTube preview -->
          <div id="yt-preview" style="display:none" class="yt-preview">
            <img id="yt-thumb" src="" alt="Thumbnail" />
            <span id="yt-channel" class="yt-channel"></span>
          </div>

          <!-- Title + Duration -->
          <div class="field-row">
            <div class="field" style="flex:2">
              <label for="title">Título *</label>
              <input type="text" id="title" name="title" placeholder="Título do clip" required />
            </div>
            <div class="field" style="flex:1">
              <label for="duration">Duração</label>
              <input type="text" id="duration" name="duration" placeholder="12:34" />
            </div>
          </div>

          <!-- Description -->
          <div class="field">
            <label for="description">Descrição / Nota</label>
            <textarea id="description" name="description" rows="2" placeholder="Resumo, nota pessoal..."></textarea>
          </div>

          <!-- Row: Tags | Collection | Clip Type -->
          <div class="field-row">
            <div class="field" style="flex:2">
              <label for="tags">Tags <span class="hint">(vírgula)</span></label>
              <input type="text" id="tags" name="tags" placeholder="trading, ted, IA" />
            </div>
            <div class="field" style="flex:1">
              <label for="collection">Coleção</label>
              <input type="text" id="collection" name="collection" placeholder="Ex: Trading" list="collection-list" />
              <datalist id="collection-list">
                {collections.map(c => <option value={c} />)}
              </datalist>
            </div>
            <div class="field" style="flex:1">
              <label for="clipType">Tipo</label>
              <select id="clipType" name="clipType">
                <option value="other">📎 Outro</option>
                <option value="tutorial">📘 Tutorial</option>
                <option value="inspiration">💡 Inspiração</option>
                <option value="research">🔬 Pesquisa</option>
                <option value="entertainment">🎬 Entretenimento</option>
                <option value="news">📰 Notícia</option>
              </select>
            </div>
          </div>

          <!-- Row: Stage | Date | Rating -->
          <div class="field-row">
            <div class="field">
              <label for="stage">Estado</label>
              <select id="stage" name="stage">
                <option value="to-watch">📋 Para ver</option>
                <option value="watching">▶️ A ver</option>
                <option value="watched">✅ Visto</option>
              </select>
            </div>
            <div class="field">
              <label for="scheduledDate">Data no calendário</label>
              <input type="date" id="scheduledDate" name="scheduledDate" />
            </div>
            <div class="field">
              <label>Rating</label>
              <div class="star-widget" id="star-widget">
                {[1,2,3,4,5].map(n => <button type="button" class="star" data-val={n}>★</button>)}
              </div>
              <input type="hidden" id="rating" name="rating" value="0" />
            </div>
          </div>

          <!-- Key Moments (Opus Clip style) -->
          <div class="field">
            <label>Momentos-chave <span class="hint">(timestamp + nota)</span></label>
            <div id="moments-list"></div>
            <button type="button" id="add-moment-btn" class="btn-ghost">+ Adicionar momento</button>
          </div>

          <!-- Hidden fields -->
          <input type="hidden" id="thumbnail" name="thumbnail" />
          <input type="hidden" id="channel" name="channel" />

          <div class="form-actions">
            <button type="submit" id="add-btn">Guardar Clip</button>
            <a href="/clips" target="_blank" class="view-link">Ver clipping ↗</a>
            <a href="/clips/dashboard" target="_blank" class="view-link">Dashboard ↗</a>
          </div>
          <p id="add-error" class="msg-error" style="display:none"></p>
          <p id="add-success" class="msg-success" style="display:none">Clip guardado!</p>
        </form>
      </section>

      <!-- ── Clips List ─────────────────────────────────────── -->
      <section class="clips-section">
        <div class="section-header">
          <h2>Clips <span class="count">({clips.length})</span></h2>
          <div class="filter-row">
            <button class="filter-btn active" data-filter="all">Todos</button>
            <button class="filter-btn" data-filter="to-watch">Para ver</button>
            <button class="filter-btn" data-filter="watching">A ver</button>
            <button class="filter-btn" data-filter="watched">Visto</button>
          </div>
        </div>

        <ul class="clips-list" id="clips-list">
          {clips.map(clip => (
            <li class="clip-item" data-id={clip.id} data-stage={clip.stage || 'to-watch'}>
              {clip.thumbnail && <img class="clip-thumb" src={clip.thumbnail} alt="" loading="lazy" />}
              <div class="clip-info">
                <div class="clip-top">
                  <a href={clip.url} target="_blank" rel="noopener noreferrer" class="clip-title">{clip.title}</a>
                  <span class={`stage-badge stage-${clip.stage || 'to-watch'}`}>{stageLabel[clip.stage || 'to-watch']}</span>
                  {clip.clipType && clip.clipType !== 'other' && <span class="type-badge">{typeEmoji[clip.clipType]}</span>}
                  {clip.rating && <span class="clip-rating">{'★'.repeat(clip.rating)}</span>}
                </div>
                <span class="clip-url">
                  {clip.channel ? `${clip.channel} · ` : ''}{getHostname(clip.url)}
                  {clip.duration && <span class="dur">· {clip.duration}</span>}
                  {clip.collection && <span class="col-badge">📁 {clip.collection}</span>}
                </span>
                {clip.tags.length > 0 && (
                  <div class="clip-tags">{clip.tags.map(t => <span class="tag">{t}</span>)}</div>
                )}
                {clip.description && <p class="clip-desc">{clip.description}</p>}
                {clip.moments && clip.moments.length > 0 && (
                  <ul class="moments-list">
                    {clip.moments.map(m => (
                      <li class="moment"><span class="moment-time">{m.time}</span><span class="moment-note">{m.note}</span></li>
                    ))}
                  </ul>
                )}
                <div class="clip-actions">
                  <select class="stage-select" data-id={clip.id}>
                    <option value="to-watch" selected={!clip.stage || clip.stage === 'to-watch'}>📋 Para ver</option>
                    <option value="watching" selected={clip.stage === 'watching'}>▶️ A ver</option>
                    <option value="watched" selected={clip.stage === 'watched'}>✅ Visto</option>
                  </select>
                  <button class="delete-btn" data-id={clip.id}>Apagar</button>
                </div>
              </div>
            </li>
          ))}
        </ul>
        {clips.length === 0 && <p class="empty" id="empty-msg">Sem clips ainda.</p>}
      </section>
    </div>
  </main>
  <Footer />
</body>
</html>

<script>
  let adminPassword = '';

  const lockScreen    = document.getElementById('lock-screen') as HTMLElement;
  const adminPanel    = document.getElementById('admin-panel') as HTMLElement;
  const passwordForm  = document.getElementById('password-form') as HTMLFormElement;
  const passwordInput = document.getElementById('password-input') as HTMLInputElement;
  const authError     = document.getElementById('auth-error') as HTMLElement;

  const saved = sessionStorage.getItem('clips-admin-pw');
  if (saved) { adminPassword = saved; unlock(); }

  passwordForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    authError.style.display = 'none';
    const pwd = passwordInput.value;
    const res = await fetch('/api/clips/auth', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ password: pwd }),
    });
    if (!res.ok) { authError.style.display = 'block'; return; }
    adminPassword = pwd;
    sessionStorage.setItem('clips-admin-pw', pwd);
    unlock();
  });

  function unlock() {
    lockScreen.style.display = 'none';
    adminPanel.style.display = 'block';
  }

  // ── YouTube auto-fill ────────────────────────────────────────
  const urlInput     = document.getElementById('url') as HTMLInputElement;
  const titleInput   = document.getElementById('title') as HTMLInputElement;
  const thumbInput   = document.getElementById('thumbnail') as HTMLInputElement;
  const channelInput = document.getElementById('channel') as HTMLInputElement;
  const ytPreview    = document.getElementById('yt-preview') as HTMLElement;
  const ytThumb      = document.getElementById('yt-thumb') as HTMLImageElement;
  const ytChannel    = document.getElementById('yt-channel') as HTMLElement;
  const fetchStatus  = document.getElementById('fetch-status') as HTMLElement;

  urlInput.addEventListener('blur', async () => {
    const url = urlInput.value.trim();
    if (!url || !/youtube\.com|youtu\.be/.test(url)) return;
    fetchStatus.textContent = '⏳ A carregar...';
    try {
      const res = await fetch(`/api/clips/oembed?url=${encodeURIComponent(url)}`);
      if (!res.ok) { fetchStatus.textContent = '⚠️ Não encontrado'; return; }
      const data = await res.json() as { title: string; channel: string; thumbnail: string };
      if (!titleInput.value) titleInput.value = data.title;
      channelInput.value = data.channel || '';
      thumbInput.value   = data.thumbnail || '';
      if (data.thumbnail) {
        ytThumb.src = data.thumbnail;
        ytChannel.textContent = data.channel || '';
        ytPreview.style.display = 'flex';
      }
      fetchStatus.textContent = '✅ YouTube detectado';
    } catch { fetchStatus.textContent = ''; }
  });

  // ── Star Rating ──────────────────────────────────────────────
  const ratingInput = document.getElementById('rating') as HTMLInputElement;
  const stars = document.querySelectorAll<HTMLButtonElement>('.star');

  stars.forEach(btn => {
    btn.addEventListener('click', () => {
      const val = parseInt(btn.dataset.val || '0');
      ratingInput.value = String(val);
      stars.forEach(s => s.classList.toggle('active', parseInt(s.dataset.val || '0') <= val));
    });
    btn.addEventListener('mouseenter', () => {
      const val = parseInt(btn.dataset.val || '0');
      stars.forEach(s => s.classList.toggle('hover', parseInt(s.dataset.val || '0') <= val));
    });
    btn.addEventListener('mouseleave', () => {
      stars.forEach(s => s.classList.remove('hover'));
    });
  });

  // ── Key Moments ──────────────────────────────────────────────
  const momentsList  = document.getElementById('moments-list') as HTMLElement;
  const addMomentBtn = document.getElementById('add-moment-btn') as HTMLButtonElement;

  addMomentBtn.addEventListener('click', () => addMomentRow('', ''));

  function addMomentRow(time: string, note: string) {
    const row = document.createElement('div');
    row.className = 'moment-row';
    row.innerHTML = `
      <input type="text" class="moment-time-input" placeholder="00:00" value="${time}" />
      <input type="text" class="moment-note-input" placeholder="Nota sobre este momento..." value="${note}" />
      <button type="button" class="btn-remove-moment">×</button>
    `;
    row.querySelector('.btn-remove-moment')!.addEventListener('click', () => row.remove());
    momentsList.appendChild(row);
    (row.querySelector('.moment-time-input') as HTMLInputElement).focus();
  }

  function getMoments() {
    return Array.from(momentsList.querySelectorAll<HTMLElement>('.moment-row'))
      .map(row => ({
        time: (row.querySelector('.moment-time-input') as HTMLInputElement).value.trim(),
        note: (row.querySelector('.moment-note-input') as HTMLInputElement).value.trim(),
      }))
      .filter(m => m.time || m.note);
  }

  // ── Add Clip Form ────────────────────────────────────────────
  const addForm    = document.getElementById('add-form') as HTMLFormElement;
  const addError   = document.getElementById('add-error') as HTMLElement;
  const addSuccess = document.getElementById('add-success') as HTMLElement;
  const addBtn     = document.getElementById('add-btn') as HTMLButtonElement;

  addForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    addError.style.display = 'none';
    addSuccess.style.display = 'none';
    addBtn.disabled = true; addBtn.textContent = 'A guardar...';

    const fd = new FormData(addForm);
    const tagsStr = fd.get('tags') as string;

    const payload = {
      url:           (fd.get('url') as string).trim(),
      title:         (fd.get('title') as string).trim(),
      description:   (fd.get('description') as string).trim(),
      tags:          tagsStr ? tagsStr.split(',').map(t => t.trim()).filter(Boolean) : [],
      stage:         fd.get('stage') as string,
      scheduledDate: (fd.get('scheduledDate') as string) || undefined,
      rating:        parseInt(fd.get('rating') as string) || undefined,
      duration:      (fd.get('duration') as string).trim() || undefined,
      collection:    (fd.get('collection') as string).trim() || undefined,
      clipType:      fd.get('clipType') as string,
      thumbnail:     (fd.get('thumbnail') as string) || undefined,
      channel:       (fd.get('channel') as string) || undefined,
      moments:       getMoments(),
    };

    try {
      const res = await fetch('/api/clips', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Admin-Password': adminPassword },
        body: JSON.stringify(payload),
      });
      if (!res.ok) {
        const err = await res.json() as { error: string };
        addError.textContent = err.error || 'Erro.';
        addError.style.display = 'block';
      } else {
        const clip = await res.json() as Clip;
        addSuccess.style.display = 'block';
        addForm.reset();
        ratingInput.value = '0';
        stars.forEach(s => s.classList.remove('active'));
        momentsList.innerHTML = '';
        ytPreview.style.display = 'none';
        fetchStatus.textContent = '';
        prependClip(clip);
        updateCount(1);
      }
    } catch {
      addError.textContent = 'Erro de rede.';
      addError.style.display = 'block';
    } finally {
      addBtn.disabled = false; addBtn.textContent = 'Guardar Clip';
    }
  });

  // ── Helpers ──────────────────────────────────────────────────
  interface Clip {
    id: string; url: string; title: string; description: string;
    tags: string[]; stage: string; thumbnail?: string; channel?: string;
    duration?: string; rating?: number;
    moments?: Array<{ time: string; note: string }>;
    collection?: string; clipType?: string;
  }

  function getHostname(url: string) {
    try { return new URL(url).hostname.replace('www.', ''); } catch { return url; }
  }

  const stageLabelMap: Record<string, string> = {
    'to-watch': '📋 Para ver', 'watching': '▶️ A ver', 'watched': '✅ Visto',
  };
  const typeEmojiMap: Record<string, string> = {
    tutorial: '📘', inspiration: '💡', research: '🔬',
    entertainment: '🎬', news: '📰', other: '📎',
  };

  function prependClip(clip: Clip) {
    document.getElementById('empty-msg')?.remove();
    const list = document.getElementById('clips-list') as HTMLUListElement;
    const li = document.createElement('li');
    li.className = 'clip-item';
    li.dataset.id    = clip.id;
    li.dataset.stage = clip.stage;
    const ratingStr  = clip.rating ? '★'.repeat(clip.rating) : '';
    const momentsHtml = clip.moments?.length
      ? `<ul class="moments-list">${clip.moments.map(m => `<li class="moment"><span class="moment-time">${m.time}</span><span class="moment-note">${m.note}</span></li>`).join('')}</ul>`
      : '';
    li.innerHTML = `
      ${clip.thumbnail ? `<img class="clip-thumb" src="${clip.thumbnail}" alt="" loading="lazy" />` : ''}
      <div class="clip-info">
        <div class="clip-top">
          <a href="${clip.url}" target="_blank" rel="noopener noreferrer" class="clip-title">${clip.title}</a>
          <span class="stage-badge stage-${clip.stage}">${stageLabelMap[clip.stage]}</span>
          ${clip.clipType && clip.clipType !== 'other' ? `<span class="type-badge">${typeEmojiMap[clip.clipType] || ''}</span>` : ''}
          ${ratingStr ? `<span class="clip-rating">${ratingStr}</span>` : ''}
        </div>
        <span class="clip-url">${clip.channel ? clip.channel + ' · ' : ''}${getHostname(clip.url)}${clip.duration ? ' · <span class="dur">' + clip.duration + '</span>' : ''}${clip.collection ? ' <span class="col-badge">📁 ' + clip.collection + '</span>' : ''}</span>
        ${clip.tags.length > 0 ? `<div class="clip-tags">${clip.tags.map(t => `<span class="tag">${t}</span>`).join('')}</div>` : ''}
        ${clip.description ? `<p class="clip-desc">${clip.description}</p>` : ''}
        ${momentsHtml}
        <div class="clip-actions">
          <select class="stage-select" data-id="${clip.id}">
            <option value="to-watch" ${clip.stage === 'to-watch' ? 'selected' : ''}>📋 Para ver</option>
            <option value="watching" ${clip.stage === 'watching' ? 'selected' : ''}>▶️ A ver</option>
            <option value="watched"  ${clip.stage === 'watched'  ? 'selected' : ''}>✅ Visto</option>
          </select>
          <button class="delete-btn" data-id="${clip.id}">Apagar</button>
        </div>
      </div>`;
    attachStageSelect(li.querySelector('.stage-select') as HTMLSelectElement);
    attachDeleteBtn(li.querySelector('.delete-btn') as HTMLButtonElement);
    list.prepend(li);
  }

  function updateCount(delta: number) {
    const el = document.querySelector('.count');
    if (!el) return;
    const n = parseInt(el.textContent?.match(/\d+/)?.[0] || '0');
    el.textContent = `(${n + delta})`;
  }

  function attachStageSelect(sel: HTMLSelectElement) {
    sel.addEventListener('change', async () => {
      const res = await fetch('/api/clips', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json', 'X-Admin-Password': adminPassword },
        body: JSON.stringify({ id: sel.dataset.id, stage: sel.value }),
      });
      if (res.ok) {
        const li = sel.closest('.clip-item') as HTMLElement;
        li.dataset.stage = sel.value;
        const badge = li.querySelector('.stage-badge') as HTMLElement;
        badge.className = `stage-badge stage-${sel.value}`;
        badge.textContent = stageLabelMap[sel.value];
        applyFilter(currentFilter);
      }
    });
  }

  function attachDeleteBtn(btn: HTMLButtonElement) {
    btn.addEventListener('click', async () => {
      if (!confirm('Apagar este clip?')) return;
      btn.disabled = true; btn.textContent = '...';
      const res = await fetch(`/api/clips/${btn.dataset.id}`, {
        method: 'DELETE', headers: { 'X-Admin-Password': adminPassword },
      });
      if (res.ok) {
        btn.closest('.clip-item')?.remove();
        updateCount(-1);
        if (!document.querySelector('.clip-item')) {
          const p = document.createElement('p');
          p.id = 'empty-msg'; p.className = 'empty'; p.textContent = 'Sem clips ainda.';
          document.getElementById('clips-list')!.after(p);
        }
      } else { btn.disabled = false; btn.textContent = 'Apagar'; }
    });
  }

  document.querySelectorAll<HTMLSelectElement>('.stage-select').forEach(attachStageSelect);
  document.querySelectorAll<HTMLButtonElement>('.delete-btn').forEach(attachDeleteBtn);

  // ── Filter ───────────────────────────────────────────────────
  let currentFilter = 'all';
  document.querySelectorAll<HTMLButtonElement>('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentFilter = btn.dataset.filter || 'all';
      applyFilter(currentFilter);
    });
  });

  function applyFilter(f: string) {
    document.querySelectorAll<HTMLElement>('.clip-item').forEach(li => {
      li.style.display = f === 'all' || li.dataset.stage === f ? '' : 'none';
    });
  }
</script>

<style>
  h1 { margin-bottom: 1.25em; }
  h2 { font-size: 1.4em; margin: 0 0 1em; }
  .count { color: rgb(var(--gray)); font-weight: 400; font-size: 0.85em; }

  /* Lock */
  #lock-screen { max-width: 420px; }
  .pw-row { display: flex; gap: 0.75em; }
  #password-input { flex: 1; }

  /* Form */
  .add-section { background: white; border: 1px solid rgb(var(--gray-light)); border-radius: 8px; padding: 1.5em; margin-bottom: 2.5em; box-shadow: var(--box-shadow); }
  .url-row { display: flex; align-items: flex-end; gap: 0.75em; margin-bottom: 0.5em; }
  .fetch-status { font-size: 0.78em; color: rgb(var(--gray)); white-space: nowrap; padding-bottom: 0.6em; }
  .yt-preview { display: flex; align-items: center; gap: 0.75em; background: rgba(var(--gray-light),0.5); border-radius: 6px; padding: 0.6em; margin-bottom: 0.75em; }
  .yt-preview img { width: 100px; border-radius: 4px; flex-shrink: 0; }
  .yt-channel { font-size: 0.82em; color: rgb(var(--gray-dark)); }
  .field { margin-bottom: 0.9em; }
  .field-row { display: flex; gap: 0.75em; flex-wrap: wrap; margin-bottom: 0; }
  .field-row .field { min-width: 140px; margin-bottom: 0.9em; }
  label { display: block; font-size: 0.82em; font-weight: 700; margin-bottom: 0.3em; color: rgb(var(--gray-dark)); }
  .hint { font-weight: 400; color: rgb(var(--gray)); }
  input[type=text], input[type=url], input[type=password], input[type=date], textarea, select {
    width: 100%; padding: 0.48em 0.7em; border: 1px solid rgb(var(--gray-light));
    border-radius: 4px; font-family: inherit; font-size: 0.93em;
    box-sizing: border-box; background: white; transition: border-color 0.15s;
  }
  input:focus, textarea:focus, select:focus { outline: none; border-color: var(--accent); }

  /* Stars */
  .star-widget { display: flex; gap: 2px; }
